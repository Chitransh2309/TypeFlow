{
  "name": "typeflow-socket-server",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone always-on Socket.io server for TypeFlow Rooms, deployed separately from the Next.js app (Render).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=cjs --external:mongodb-client-encryption --external:kerberos --external:snappy --external:@mongodb-js/zstd --external:aws4 --external:gcp-metadata --external:@aws-sdk/*",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "7.1.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
